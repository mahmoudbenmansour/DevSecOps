pipeline {
    agent any

    environment {
        IMAGE_NAME = 'achat-app'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Recuperation du code source depuis Git...'
                checkout scm
            }
        }

        stage('Clean & Compile') {
            steps {
                dir('achat') {
                    echo 'Nettoyage et compilation du projet...'
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('achat') {
                    echo 'Execution des tests unitaires...'
                    bat 'mvn test'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('achat') {
                    echo 'Analyse de la qualite du code avec SonarQube...'
                    withSonarQubeEnv('SonarQube') {
                        bat 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.projectKey=achat-app -Dsonar.projectName=achat-app'
                    }
                }
            }
        }

        stage('Package') {
            steps {
                dir('achat') {
                    echo 'Generation du fichier JAR...'
                    bat 'mvn package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('achat') {
                    echo 'Construction de l image Docker...'
                    bat 'docker build -t %IMAGE_NAME% .'
                }
            }
        }

        stage('Run with Docker Compose') {
            steps {
                dir('achat') {
                    echo 'Arret et suppression des anciens conteneurs...'
                    bat 'docker compose down -v --remove-orphans || exit 0'

                    echo 'Demarrage de la base et de l application avec Docker Compose...'
                    bat 'docker compose up -d'

                    echo 'Verification des conteneurs en cours...'
                    bat 'docker ps'
                }
            }
        }

        stage('Publish to Nexus') {
            steps {
                dir('achat') {
                    echo 'Publication de l artifact dans Nexus...'
                    configFileProvider([configFile(fileId: '96c23311-fbc7-4aa0-a4c4-bc0686d66999', variable: 'MAVEN_SETTINGS')]) {
                        bat 'mvn deploy -s %MAVEN_SETTINGS% -DskipTests'
                    }
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                echo 'Archivage du fichier JAR genere...'
                archiveArtifacts artifacts: 'achat/target/*.jar', fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'Pipeline execute avec succes.'
        }
        failure {
            echo 'Le pipeline a echoue.'
        }
        always {
            junit allowEmptyResults: true, testResults: 'achat/target/surefire-reports/*.xml'
        }
    }
}