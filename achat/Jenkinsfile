pipeline {
    agent any

    environment {
        IMAGE_NAME = 'achat-app'
        IMAGE_TAG = 'latest'
        FULL_IMAGE = 'achat-app:latest'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Clean & Compile') {
            steps {
                dir('achat') {
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('achat') {
                    bat 'mvn test'
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                dir('achat') {
                    script {
                        def dcHome = tool 'owasp-dc'

                        bat """
                        if not exist reports mkdir reports

                        ${dcHome}\\bin\\dependency-check.bat ^
                        --project achat-app ^
                        --scan . ^
                        --format HTML ^
                        --out reports ^
                        --disableCentral ^
                        --noupdate ^
                        --nvdMaxRetryCount 2
                        """
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('achat') {
                    withSonarQubeEnv('SonarQube') {
                        bat 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Package') {
            steps {
                dir('achat') {
                    bat 'mvn package -DskipTests'
                }
            }
        }

        // =========================
        // TRIVY FS SCAN (OPTIMIZED)
        // =========================
        stage('Trivy FS Scan') {
            steps {
                dir('achat') {
                    bat '''
                    docker run --rm ^
                    -v %cd%:/project ^
                    -v %USERPROFILE%\\.cache\\trivy:/root/.cache/ ^
                    aquasec/trivy fs --no-progress /project
                    '''
                }
            }
        }

        // =========================
        // BUILD IMAGE
        // =========================
        stage('Build Docker Image') {
            steps {
                dir('achat') {
                    bat 'docker build -t %FULL_IMAGE% .'
                }
            }
        }

        // =========================
        // TRIVY IMAGE SCAN (FIXED WINDOWS)
        // =========================
        stage('Trivy Image Scan') {
            steps {
                script {
                    try {
                        bat '''
                        docker run --rm ^
                        -v /var/run/docker.sock:/var/run/docker.sock ^
                        aquasec/trivy image --no-progress achat-app:latest
                        '''
                    } catch (Exception e) {
                        echo "⚠ Docker socket not available → using local Trivy fallback"

                        bat '''
                        docker run --rm ^
                        -v %cd%:/project ^
                        -v %USERPROFILE%\\.cache\\trivy:/root/.cache/ ^
                        aquasec/trivy fs --no-progress /project
                        '''
                    }
                }
            }
        }

        stage('Run Application & Stack') {
            steps {
                dir('achat') {
                    bat 'docker compose down -v --remove-orphans || exit 0'
                    bat 'docker compose up -d'
                    bat 'docker ps'
                }
            }
        }

        // =========================
        // OWASP ZAP (STABLE MODE)
        // =========================
        stage('OWASP ZAP Scan') {
            steps {
                dir('achat') {
                    bat '''
                    if not exist reports mkdir reports

                    docker run --rm ^
                    ghcr.io/zaproxy/zaproxy zap-baseline.py ^
                    -t http://host.docker.internal:8089/SpringMVC ^
                    -r reports/zap-report.html ^
                    -I ^
                    -m 5
                    '''
                }
            }
        }

        stage('Check Monitoring') {
            steps {
                bat 'docker ps --filter "name=prometheus"'
                bat 'docker ps --filter "name=grafana"'
            }
        }

        stage('Publish to Nexus') {
            steps {
                dir('achat') {
                    configFileProvider([configFile(fileId: '96c23311-fbc7-4aa0-a4c4-bc0686d66999', variable: 'MAVEN_SETTINGS')]) {
                        bat 'mvn deploy -s %MAVEN_SETTINGS% -DskipTests'
                    }
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: 'achat/target/*.jar', fingerprint: true
            }
        }
    }

    post {
        success {
            echo '✅ DevSecOps Pipeline SUCCESS'
        }
        failure {
            echo '❌ Pipeline FAILED (check Trivy / Docker / ZAP / Sonar)'
        }
        always {
            junit allowEmptyResults: true,
                    testResults: 'achat/target/surefire-reports/*.xml'
        }
    }
}