pipeline {
    agent any

    environment {
        IMAGE_NAME = 'achat-app'
        IMAGE_TAG = 'latest'
        FULL_IMAGE = "achat-app:latest"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Clean & Compile') {
            steps {
                dir('achat') {
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('achat') {
                    bat 'mvn test'
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                dir('achat') {
                    script {
                        def dcHome = tool 'owasp-dc'

                        bat """
                        if not exist reports mkdir reports

                        ${dcHome}\\bin\\dependency-check.bat ^
                        --project achat-app ^
                        --scan . ^
                        --format HTML ^
                        --out reports ^
                        --disableCentral ^
                        --noupdate ^
                        --nvdMaxRetryCount 2
                        """
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('achat') {
                    withSonarQubeEnv('SonarQube') {
                        bat 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Package') {
            steps {
                dir('achat') {
                    bat 'mvn package -DskipTests'
                }
            }
        }

        // =========================
        // TRIVY FS SCAN
        // =========================
        stage('Trivy FS Scan') {
            steps {
                dir('achat') {
                    bat '''
                    docker run --rm ^
                    -v "%cd%:/project" ^
                    -v trivy-cache:/root/.cache/ ^
                    aquasec/trivy fs --no-progress /project
                    '''
                }
            }
        }

        // =========================
        // BUILD DOCKER IMAGE
        // =========================
        stage('Build Docker Image') {
            steps {
                dir('achat') {
                    bat 'docker build -t %FULL_IMAGE% .'
                }
            }
        }

        // =========================
        // ✅ FIXED TRIVY IMAGE SCAN (IMPORTANT)
        // =========================
        stage('Trivy Image Scan') {
            steps {
                dir('achat') {
                    bat '''
                    docker run --rm ^
                    -v trivy-cache:/root/.cache/ ^
                    aquasec/trivy image ^
                    --timeout 20m ^
                    --no-progress ^
                    --scanners vuln ^
                    %FULL_IMAGE%
                    '''
                }
            }
        }

        // =========================
        // RUN STACK
        // =========================
        stage('Run Application & Stack') {
            steps {
                dir('achat') {
                    bat 'docker compose down -v --remove-orphans || exit 0'
                    bat 'docker compose up -d'
                    bat 'docker ps'
                }
            }
        }

        // =========================
        // OWASP ZAP
        // =========================
        stage('OWASP ZAP Scan') {
            steps {
                dir('achat') {
                    bat '''
                    if not exist reports mkdir reports

                    docker run --rm ^
                    ghcr.io/zaproxy/zaproxy zap-baseline.py ^
                    -t http://host.docker.internal:8089/SpringMVC ^
                    -r reports/zap-report.html ^
                    -I
                    '''
                }
            }
        }

        stage('Check Monitoring') {
            steps {
                bat 'docker ps --filter "name=prometheus"'
                bat 'docker ps --filter "name=grafana"'
            }
        }

        stage('Publish to Nexus') {
            steps {
                dir('achat') {
                    configFileProvider([configFile(fileId: '96c23311-fbc7-4aa0-a4c4-bc0686d66999', variable: 'MAVEN_SETTINGS')]) {
                        bat 'mvn deploy -s %MAVEN_SETTINGS% -DskipTests'
                    }
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: 'achat/target/*.jar', fingerprint: true
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline DevSecOps OK'
        }

        failure {
            echo '❌ Pipeline FAILED (Trivy / Docker / Sonar / ZAP)'
        }

        always {
            junit allowEmptyResults: true,
                    testResults: 'achat/target/surefire-reports/*.xml'
        }
    }
}